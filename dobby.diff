+  "KSsssSSGPPGSSGPPGSSsssSK",
+  "KSSssSSGPPGSSGPPGSSssSSK",
+  ".KKSSSSGGGGSSGGGGSSSSKK.",
+  "...KKSSSSSSssSSSSSSKK...",
+  "......KKSSSSSSSSKK......",
+  "........KTTTTTTK........",
+  "......KSKTTTTTTKSK......",
+  "......KKKTTTTTTKKK......",
+  "........KSK..KSK........",
+  ".......KSSK..KSSK.......",
+]
+
+export const elf = Array.from({ length: elfPixels.length / 2 }, (_, row) =>
+  Array.from(elfPixels[row * 2], (_, column) => {
+    const top = elfPalette[elfPixels[row * 2][column]]
+    const bottom = elfPalette[elfPixels[row * 2 + 1][column]]
+    if (top && bottom) return { char: top === bottom ? "█" : "▀", fg: top, bg: top === bottom ? undefined : bottom }
+    if (top) return { char: "▀", fg: top }
+    if (bottom) return { char: "▄", fg: bottom }
+    return { char: " " }
+  }),
+)
+
