+// Dobby the house elf as pixel art. Two pixel rows fold into one terminal row of half blocks.
+const elfPalette: Record<string, string> = {
+  K: "#111111",
+  S: "#e8cbb5",
+  s: "#b9a596",
+  G: "#6b8e2f",
